}

func TestFetchImageToBase64_InvalidImage(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Write([]byte("This is not an image"))
	}))
	defer server.Close()

	proxyClient = server.Client()

	_, _, err := fetchImageToBase64(server.URL)
	if err == nil {
		t.Error("fetchImageToBase64() should return error for invalid image data")
	}

	if !strings.Contains(err.Error(), "invalid image") {
		t.Errorf("fetchImageToBase64() error = %v, want 'invalid image'", err)
	}
}

func TestConvertMultimodalContent_InvalidJSON(t *testing.T) {
	invalidJSON := []byte("not valid json")

	result, err := convertMultimodalContent(invalidJSON)
	if err != nil {
		t.Errorf("convertMultimodalContent() should not error on invalid JSON, got %v", err)
	}

	// Should return original bytes
	if !bytes.Equal(result, invalidJSON) {
		t.Error("convertMultimodalContent() should return original bytes for invalid JSON")
	}
}

func TestProcessContentArray_PDFDocument(t *testing.T) {
	// Setup test PDF server
	pdfBytes := createTestPDF()
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/pdf")
		w.Write(pdfBytes)
	}))
	defer server.Close()

	proxyClient = server.Client()

	// Create test message with document
	msg := map[string]interface{}{
		"content": []interface{}{
			map[string]interface{}{
				"type": "text",
				"text": "Summarize this document",
			},
			map[string]interface{}{
				"type": "pdf",
				"document_url": server.URL,
			},
		},
	}

	modified := processContentArray(msg, "content")
	if !modified {
		t.Error("processContentArray() should return true when PDF is processed")
	}

	// Verify conversion to inline_data
	content := msg["content"].([]interface{})
	pdfItem := content[1].(map[string]interface{})

	inlineData, ok := pdfItem["inline_data"].(map[string]interface{})
	if !ok {
		t.Fatal("'inline_data' field not found")
	}

	if mimeType := inlineData["mime_type"]; mimeType != "application/pdf" {
		t.Errorf("mime_type = %v, want application/pdf", mimeType)
	}

	// Verify it's valid base64
	data := inlineData["data"].(string)
	decoded, err := base64.StdEncoding.DecodeString(data)
	if err != nil {
		t.Fatalf("base64 decode error: %v", err)
	}

	if !bytes.HasPrefix(decoded, []byte("%PDF")) {
		t.Error("decoded PDF should start with magic bytes")
	}
}
