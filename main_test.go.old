// --- Error Handling Tests ---

func TestFetchImageToBase64_InvalidURL(t *testing.T) {
	_, _, err := fetchImageToBase64("not a valid url")
	if err == nil {
		t.Error("fetchImageToBase64() should return error for invalid URL")
	}
}

func TestFetchImageToBase64_404(t *testing.T) {
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusNotFound)
	}))
	defer server.Close()

	proxyClient = server.Client()

	_, _, err := fetchImageToBase64(server.URL)
